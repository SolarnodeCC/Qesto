    },
    "/v3/usage": {
      "get": {
        "tags": [
          "v3"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v3Usage",
        "summary": "API usage for the current metering window",
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "usage",
                        "quota"
                      ],
                      "properties": {
                        "usage": {
                          "type": "object",
                          "required": [
                            "teamId",
                            "windowStart",
                            "requestCount",
                            "lastRequestAt"
                          ],
                          "properties": {
                            "teamId": {
                              "type": "string"
                            },
                            "windowStart": {
                              "type": "integer",
                              "description": "Epoch seconds"
                            },
                            "requestCount": {
                              "type": "integer"
                            },
                            "lastRequestAt": {
                              "type": "integer",
                              "description": "Epoch milliseconds"
                            }
                          }
                        },
                        "quota": {
                          "type": "object",
                          "required": [
                            "requestsPerDay"
                          ],
                          "properties": {
                            "requestsPerDay": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
