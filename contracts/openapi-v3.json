            "$ref": "#/components/responses/E429"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/v3/residency": {
      "get": {
        "tags": [
          "v3"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v3Residency",
        "summary": "Data-residency configuration and proof for the team",
        "responses": {
          "200": {
            "description": "Residency",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "teamId",
                        "homeRegion",
                        "writeBinding",
                        "effectiveRegion",
                        "residencyLocked",
                        "proof"
                      ],
                      "properties": {
                        "teamId": {
                          "type": "string"
                        },
                        "homeRegion": {
                          "type": "string"
                        },
                        "regionLock": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "writeBinding": {
                          "type": "string"
                        },
                        "effectiveRegion": {
                          "type": "string"
                        },
                        "residencyLocked": {
                          "type": "boolean"
                        },
                        "proof": {
                          "type": "object",
                          "properties": {
                            "checkedAt": {
                              "type": "integer"
                            },
                            "source": {
                              "type": "string"
                            },
                            "multiRegionWritesEnabled": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "429": {
            "$ref": "#/components/responses/E429"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Team API key: `qesto_` + 32 hex characters"
      }
    },
    "schemas": {
      "Session": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "code",
          "team_id",
          "owner_id",
          "created_at",
          "closed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "energizing",
              "live",
              "closed",
              "archived"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "owner_id": {
            "type": "string"
          },
          "created_at": {
            "type": "integer",
            "description": "Epoch milliseconds"
          },
          "closed_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "SessionBasic": {
        "type": "object",
        "required": [
          "id",
          "team_id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "team_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "QuestionSummary": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "prompt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          }
        }
      },
      "VoteCount": {
        "type": "object",
        "required": [
          "question_id",
          "option_id",
          "count"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "option_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "trace_id": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "E400": {
        "description": "Invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, malformed or revoked API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E403": {
        "description": "API key lacks the required scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
