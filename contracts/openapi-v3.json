{
  "openapi": "3.1.0",
  "info": {
    "title": "Qesto Public API",
    "version": "3.0.0",
    "description": "Bearer-authenticated with a team API key (`qesto_` + 32 hex). Rate limit: 120 requests/min per key (429 with Retry-After). v1 sunsets 2026-12-31 and v2 sunsets 2027-06-30 — both send `Deprecation`, `Sunset` and `Link: rel=\"successor-version\"` headers; migrate to v3."
  },
  "servers": [
    {
      "url": "https://qesto.cc/api"
    }
  ],
  "paths": {
    "/v1/sessions": {
      "get": {
        "tags": [
          "v1 (deprecated)"
        ],
        "deprecated": true,
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v1ListSessions",
        "summary": "List team sessions (newest first)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque `nextCursor` from the previous page (keyset pagination).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of sessions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "sessions",
                        "nextCursor"
                      ],
                      "properties": {
                        "sessions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Session"
                          }
                        },
                        "nextCursor": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Null on the last page."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "429": {
            "$ref": "#/components/responses/E429"
          }
        }
      }
    },
    "/v1/sessions/{id}/results": {
      "get": {
        "tags": [
          "v1 (deprecated)"
        ],
        "deprecated": true,
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v1SessionResults",
        "summary": "Session results",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "session",
                        "questions",
                        "vote_counts"
                      ],
                      "properties": {
                        "session": {
                          "$ref": "#/components/schemas/Session"
                        },
                        "questions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/QuestionSummary"
                          }
                        },
                        "vote_counts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/VoteCount"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "429": {
            "$ref": "#/components/responses/E429"
          }
        }
      }
    },
    "/v2/sessions": {
      "post": {
        "tags": [
          "v2 (deprecated)"
        ],
        "deprecated": true,
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v2CreateSession",
        "summary": "Create a draft session",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "code",
                        "title",
                        "status",
                        "teamId",
                        "createdAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "const": "draft"
                        },
                        "teamId": {
                          "type": "string"
                        },
                        "createdAt": {
                          "type": "integer",
                          "description": "Epoch milliseconds"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "429": {
            "$ref": "#/components/responses/E429"
          }
        }
      }
    },
    "/v2/sessions/{id}/results": {
      "get": {
        "tags": [
          "v2 (deprecated)"
        ],
        "deprecated": true,
        "security": [
          {
            "bearer": []
          }
        ],
        "operationId": "v2SessionResults",
        "summary": "Session results (v2 names the vote array `votes`)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
